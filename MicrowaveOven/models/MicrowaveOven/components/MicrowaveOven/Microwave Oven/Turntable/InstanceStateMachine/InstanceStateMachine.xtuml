// BP 7.1.6 content: InstanceStateMachine syschar: 3 persistence-version: 7.1.6

within MicrowaveOven::components::MicrowaveOven::'Microwave Oven'::Turntable is

  @state_num(1);
  @dialect("oal");
  state Stationary;

  @state_num(2);
  @dialect("oal");
  state Rotating;

  @event_num(1);
  event spin;

  @event_num(2);
  event stop;

  @event_num(3);
  event create_turntable;

  state model is

    |                  | spin             | stop             | create_turntable |
    | ---------------- | ---------------- | ---------------- | ---------------- |
    | non_existent     | cannot_happen    | cannot_happen    | Stationary       |
    | Stationary       | Rotating         | ignore           | cannot_happen    |
    | Rotating         | ignore           | Stationary       | cannot_happen    |

  end state model;

  state Stationary is
    @noparse
    // Turntable stationary
    @endnoparse
  end state;

  state Rotating is
    @noparse
    // Turntable spinning
    @endnoparse
  end state;

end;
